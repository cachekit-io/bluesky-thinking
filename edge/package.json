    "prettier": "^3.6.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4",
    "wrangler": "^4.42.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
